# Chimera Backend - copy to .env and set values
# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/chimera

# Weaviate (semantic memory / RAG)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# Redis (episodic cache)
REDIS_URL=redis://localhost:6379/0

# Confidence thresholds (constitution: high > 0.90, medium 0.70-0.90, low < 0.70)
CONFIDENCE_HIGH=0.90
CONFIDENCE_MEDIUM=0.70

# MCP (optional - server URL if using remote MCP)
# MCP_SERVER_URL=
